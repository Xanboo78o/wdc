#!/usr/bin/env bash
# native/vr — sit in the cockpit.   native/vr [track] [car]      (e.g. native/vr monza f1)
#
# What it does for you: starts the headset server if it is not running, forwards the USB cable's port, opens the WiVRn app on the
# Quest, waits for it to connect, and starts the game with --vr. PUT THE HEADSET ON FIRST (it must be awake and worn).
#
# Measured on this laptop (GTX 1060 + the stream's own encoding): 20-car race, 77 fps at --vrscale 0.45, falls under 72 at 0.55.
# A headset that is not given its 72 frames a second shows a torn, flickering picture, so do not raise --vrscale without
# watching the "vr: NN fps" lines this prints every 3 seconds. Under 72 for long: take the headset off.
set -e
command -v adb >/dev/null || { echo "native/vr: adb is not installed (pacman -S android-tools)"; exit 1; }
adb devices | grep -q 'device$' || { echo "native/vr: the Quest is not on the USB cable (or has not allowed USB debugging)"; exit 1; }
if ! pgrep -x wivrn-server >/dev/null; then
  nohup wivrn-server --no-publish-service --no-manage-active-runtime > /tmp/xbr-wivrn-server.log 2>&1 &
  sleep 2
fi
adb reverse tcp:9757 tcp:9757 >/dev/null
adb shell am force-stop org.meumeu.wivrn.github
sleep 1
adb shell am start -a android.intent.action.VIEW -d 'wivrn+tcp://127.0.0.1:9757' org.meumeu.wivrn.github >/dev/null 2>&1
cd "$(dirname "$0")/.."
make -s -C native
exec native/build/xbr "$@" --vr
